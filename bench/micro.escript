#!/usr/bin/env escript
%%! -pa _build/default/lib/auctions/ebin -pa _build/default/lib/lfe/ebin
main(_) ->
    file:delete("tmp/micro.log"),
    {ok, _} = disk_log:open([{name, m}, {file, "tmp/micro.log"}, {type, halt}, {format, internal}]),
    Ev = {'bid-accepted', 1700000000000, {bid, 1, {'buyer-or-seller', <<"a2">>, <<"Buyer">>}, 1700000000000, 100}},
    N = 200,
    {T1, _} = timer:tc(fun() -> [ok = disk_log:log(m, Ev) || _ <- lists:seq(1, N)] end),
    {T2, _} = timer:tc(fun() -> [begin ok = disk_log:log(m, Ev), ok = disk_log:sync(m) end || _ <- lists:seq(1, N)] end),
    {T3, _} = timer:tc(fun() -> [begin ok = disk_log:log_terms(m, lists:duplicate(32, Ev)), ok = disk_log:sync(m) end || _ <- lists:seq(1, N div 8)] end),
    io:format("disk_log:log            ~.1f us/event~n", [T1 / N]),
    io:format("disk_log:log+sync       ~.1f us/event~n", [T2 / N]),
    io:format("log_terms(32)+sync      ~.1f us/batch, ~.1f us/event~n", [T3 / (N div 8), T3 / (N div 8) / 32]),
    Ms = 1700000000123,
    M = 20000,
    {T4, _} = timer:tc(fun() -> [clock:format(Ms) || _ <- lists:seq(1, M)] end),
    io:format("clock:format            ~.2f us/call~n", [T4 / M]),
    {T4b, _} = timer:tc(fun() -> [calendar:system_time_to_rfc3339(Ms, [{unit, millisecond}, {offset, "Z"}]) || _ <- lists:seq(1, M)] end),
    io:format("  of which rfc3339      ~.2f us/call~n", [T4b / M]),
    A = {auction, 1, 1700000000000, <<"Auction 1">>, 1800000000000, {'buyer-or-seller', <<"a1">>, <<"Test">>}, {'timed-ascending', #{'reserve-price' => 0, 'min-raise' => 0, 'time-frame' => 0}}, vac},
    {T5, _} = timer:tc(fun() -> [web_types_item(A) || _ <- lists:seq(1, M)] end),
    io:format("auction-list-item       ~.2f us/call~n", [T5 / M]),
    Items = [web_types_item(A) || _ <- lists:seq(1, 50)],
    K = 2000,
    {T6, _} = timer:tc(fun() -> [json:encode(Items) || _ <- lists:seq(1, K)] end),
    io:format("json:encode 50 items    ~.1f us/call~n", [T6 / K]),
    Bin = iolist_to_binary(json:encode(Items)),
    io:format("encoded size ~p bytes~n", [byte_size(Bin)]),
    {T7, _} = timer:tc(fun() -> [json:decode(<<"{\"amount\":100}">>) || _ <- lists:seq(1, M)] end),
    io:format("json:decode small       ~.2f us/call~n", [T7 / M]),
    H = <<"eyJzdWIiOiJhMiIsICJuYW1lIjoiQnV5ZXIiLCAidV90eXAiOiIwIn0K">>,
    {T8, _} = timer:tc(fun() -> [jwt:'decode-user'(H) || _ <- lists:seq(1, M)] end),
    io:format("jwt:decode-user         ~.2f us/call~n", [T8 / M]),
    {T9, _} = timer:tc(fun() -> [clock:parse(<<"2023-01-01T10:00:00.000Z">>) || _ <- lists:seq(1, M)] end),
    io:format("clock:parse             ~.2f us/call~n", [T9 / M]),
    {T10, _} = timer:tc(fun() -> [clock:now() || _ <- lists:seq(1, M)] end),
    io:format("clock:now               ~.2f us/call~n", [T10 / M]),
    disk_log:close(m), file:delete("tmp/micro.log").
web_types_item(A) -> 'web-types':'auction-list-item'(A).
