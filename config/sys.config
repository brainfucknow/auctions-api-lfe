%% Runtime configuration for the release.
%%
%% Hyphenated LFE module and log names are ordinary atoms and must be quoted
%% here, e.g. 'auctions-sup'.
[
  {auctions, [
      {events_file, "/var/lib/auctions/events.log"},
      {http_port, 8080}
      %% Set to false to skip the fsync after each write batch. Events then
      %% survive a crash of the node but not of the machine; see PARITY.md.
      %% , {events_fsync, false}
  ]},
  {kernel, [
      {logger_level, info}
  ]}
].
